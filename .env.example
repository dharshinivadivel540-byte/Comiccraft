# ==========================================
# ComicCraft Environment Configuration
# ==========================================

# Google Gemini API key
GEMINI_API_KEY=

# Gemini models
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro


# ==========================================
# Hugging Face
# ==========================================

HF_TOKEN=

HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

HF_PROVIDER=auto


# ==========================================
# Application
# ==========================================

# TRUE = run without API keys
# FALSE = use real AI services
DEMO_MODE=true

APP_NAME=ComicCraft

MAX_PANELS=5

IMAGE_WIDTH=768

IMAGE_HEIGHT=1024